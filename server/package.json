{
  "name": "nest-fastify",
  "version": "0.0.1",
  "description": "NestJS microservices with Fastify, gRPC, RabbitMQ, Prisma/PostgreSQL and JWT auth",
  "author": "mortogo321",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "build:all": "bun run build:api && bun run build:auth && bun run build:alert && bun run build:payment && bun run build:worker",
    "build:api": "nest build api && bun run build:protos",
    "build:auth": "nest build auth && bun run build:protos",
    "build:alert": "nest build alert && bun run build:protos",
    "build:payment": "nest build payment && bun run build:protos",
    "build:worker": "nest build worker && bun run build:protos",
    "build:protos": "mkdir -p dist/proto && cp libs/proto/*.proto dist/proto/",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api/main",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "ci:check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "validate": "bun run typecheck && bun run check",
    "prisma:dev": "dotenvx run -f .env.prisma -f .env.dev -- prisma",
    "prisma:prod": "dotenvx run -f .env.prisma -f .env.prod -- prisma",
    "prisma:generate": "bun run prisma:dev generate --schema prisma/schema",
    "prisma:generate:prod": "bun run prisma:prod generate --schema prisma/schema",
    "prisma:migrate": "bun run prisma:dev migrate dev --schema prisma/schema",
    "prisma:migrate:prod": "bun run prisma:prod migrate deploy --schema prisma/schema",
    "prisma:studio": "bun run prisma:dev studio --schema prisma/schema",
    "proto:generate": "protoc --ts_proto_out=./libs/common/src/types ./libs/proto/*.proto --ts_proto_opt=esModuleInterop=true --proto_path=./libs/proto"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "nest-winston": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@dotenvx/dotenvx": "^2.32.3",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "@vitest/coverage-v8": "^5.0.3",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-loader": "^9.6.2",
    "ts-proto": "^2.12.4",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
