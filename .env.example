# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=nestjs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_URI=amqp://admin:admin@localhost:5672

# ============================================
# Queue Names
# ============================================
AUTH_QUEUE=auth
ALERT_QUEUE=alert
PAYMENT_QUEUE=payment
WORKER_QUEUE=worker

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-in-production
JWT_EXPIRATION=1h
JWT_COOKIES=access_token

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=8000

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:8000,http://localhost:8001

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ============================================
# OAuth Configuration (Optional)
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8001/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8001/auth/facebook/callback

# ============================================
# Authenticator Configuration
# ============================================
AUTHENTICATOR_APP_NAME=NestJS Fastify
